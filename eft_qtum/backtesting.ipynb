m\u001b[30;43m)\u001b[39;49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/opt/homebrew/Caskroom/miniforge/base/envs/vbt_env/lib/python3.13/site-packages/vectorbt/data/base.py:528\u001b[39m, in \u001b[36mData.from_data\u001b[39m\u001b[34m(cls, data, tz_localize, tz_convert, missing_index, missing_columns, wrapper_kwargs, **kwargs)\u001b[39m\n\u001b[32m    526\u001b[39m \u001b[38;5;66;03m# Align index and columns\u001b[39;00m\n\u001b[32m    527\u001b[39m data = \u001b[38;5;28mcls\u001b[39m.align_index(data, missing=missing_index)\n\u001b[32m--> \u001b[39m\u001b[32m528\u001b[39m data = \u001b[30;43mcls\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43malign_columns\u001b[39;49m\u001b[30;43m(\u001b[39;49m\u001b[30;43mdata\u001b[39;49m\u001b[30;43m,\u001b[39;49m\u001b[30;43m \u001b[39;49m\u001b[30;43mmissing\u001b[39;49m\u001b[30;43m=\u001b[39;49m\u001b[30;43mmissing_columns\u001b[39;49m\u001b[30;43m)\u001b[39;49m\n\u001b[32m    530\u001b[39m \u001b[38;5;66;03m# Create new instance\u001b[39;00m\n\u001b[32m    531\u001b[39m symbols = \u001b[38;5;28mlist\u001b[39m(data.keys())\n",
