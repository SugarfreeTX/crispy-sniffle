   "source": [
    "import vectorbt as vbt\n",
    "import yfinance as yf\n",
    "print(\"vectorbt version:\", getattr(vbt, \"__version__\", \"unknown\"))\n",
    "print(\"yfinance version:\", getattr(yf, \"__version__\", \"unknown\"))\n",
    "print(\"Kernel python:\", __import__(\"sys\").executable)\n",
    "import pandas as pd\n",
