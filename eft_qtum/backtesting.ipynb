   ],
   "source": [
    "# ================== DATA LOADING ==================\n",
    "\n",
    "print(\"Downloading data...\")\n",
    "\n",
    "# Download symbols *separately* (one at a time). The multi-symbol path\n",
    "# in vbt.YFData.download([list]) raises \"Symbols have mismatching columns\"\n",
    "# with current yfinance (always emits Ticker level in columns) + vectorbt.\n",
    "price = vbt.YFData.download(\n",
    "    SYMBOL,\n",
    "    start=START_DATE,\n",
    "    end=END_DATE,\n",
    "    interval=\"1d\"\n",
    ").get(\"Close\")\n",
    "\n",
    "vix = vbt.YFData.download(\n",
    "    VIX_SYMBOL,\n",
    "    start=START_DATE,\n",
    "    end=END_DATE,\n",
    "    interval=\"1d\"\n",
    ").get(\"Close\")\n",
    "\n",
    "# yfinance .history() often returns tz-aware indexes with different\n",
    "# sub-day times (04:00 vs 06:00) even for the same UTC day across symbols.\n",
    "# Normalize to midnight so the subsequent align() can match dates.\n",
    "price.index = price.index.normalize()\n",
    "vix.index = vix.index.normalize()\n",
    "\n",
    "# Align dates\n",
    "price, vix = price.align(vix, join='inner')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b84119d7",
   "metadata": {},
   "source": [
    "### **INDICATORS**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2cd1bdac",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ================== INDICATORS ==================\n",
    "# Moving Averages\n",
    "ma_fast = vbt.MA.run(price, window=FAST_MA, ewm=False)\n",
    "ma_slow = vbt.MA.run(price, window=SLOW_MA, ewm=False)\n",
    "\n",
    "# Golden / Death Cross signals\n",
    "golden_cross = ma_fast.ma_crossed_above(ma_slow)\n",
    "death_cross = ma_fast.ma_crossed_below(ma_slow)\n",
    "\n",
    "# VIX Regime\n",
    "in_calm_regime = vix < VIX_ENTER\n",
    "in_risk_off = vix >= VIX_EXIT"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "15d5e4d0",
   "metadata": {},
   "source": [
    "### **ENTRY / EXIT SIGNALS**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cdd4e48c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ================== ENTRY / EXIT SIGNALS ==================\n",
    "# Long when: Golden Cross AND calm regime\n",
    "# (You can also use sustained condition: ma_fast.ma > ma_slow AND calm)\n",
    "entries = golden_cross & in_calm_regime\n",
    "\n",
    "# Exit when: Death Cross OR risk-off\n",
    "exits = death_cross | in_risk_off\n",
    "\n",
    "# Optional: Stay in position only while trend + regime both favorable\n",
    "# trend_up = ma_fast.ma > ma_slow.ma\n",
    "# entries = trend_up & in_calm_regime\n",
    "# exits = ~trend_up | in_risk_off"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9666918a",
   "metadata": {},
   "source": [
    "### **BACKTEST**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4b28f11b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ================== BACKTEST ==================\n",
    "pf = vbt.Portfolio.from_signals(\n",
    "    price,\n",
    "    entries=entries,\n",
    "    exits=exits,\n",
    "    init_cash=INITIAL_CASH,\n",
    "    fees=FEES,\n",
    "    slippage=SLIPPAGE,\n",
    "    direction=\"longonly\",\n",
    "    freq=\"1D\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ad230884",
